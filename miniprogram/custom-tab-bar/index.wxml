<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view 
    class="tab-bar-item" 
    wx:for="{{list}}" 
    wx:key="index"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon" style="{{selected === index ? 'transform: scale(1.1);' : ''}}">
      <image wx:if="{{item.iconPath}}" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit" />
      <text wx:else class="tab-emoji">{{item.emoji}}</text>
    </view>
    <view class="tab-text {{selected === index ? 'active' : ''}}">{{item.text}}</view>
  </view>
</view>
