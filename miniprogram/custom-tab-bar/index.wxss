.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-bar-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background-color: #F0F0F0;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 16rpx;
  transition: all 0.2s ease;
}

.tab-bar-item:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  margin-bottom: 8rpx;
}

.tab-icon image {
  width: 48rpx;
  height: 48rpx;
}

.tab-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
  transition: all 0.2s ease;
  font-weight: normal;
}

.tab-text.active {
  color: #4CAF50;
  font-weight: bold;
  font-size: 24rpx;
}
