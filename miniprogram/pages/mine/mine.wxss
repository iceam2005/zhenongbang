.user-section {
  background: linear-gradient(135deg, #d4a574 0%, #c49464 100%);
  padding: 40rpx 30rpx;
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 20rpx;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.user-id {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.edit-btn {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.user-stats {
  display: flex;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 24rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  background: rgba(255, 255, 255, 0.3);
}

.menu-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 150rpx;
}

.menu-card {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  margin-right: 20rpx;
}

.order-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.cart-icon {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.fav-icon {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.msg-icon {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.supply-icon {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.demand-icon {
  background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
}

.activity-icon {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
}

.coupon-icon {
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
}

.help-icon {
  background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
}

.setting-icon {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.cart-badge, .msg-badge {
  position: absolute;
  right: 60rpx;
  background: #e53935;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}

.footer-copyright {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}