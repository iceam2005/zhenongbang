<view class="container">
  <view class="user-section">
    <view class="user-header">
      <view class="avatar-wrap">
        <image class="user-avatar" src="{{avatarUrl}}" mode="aspectFill" />
        <text class="avatar-label">默认头像</text>
      </view>
      <view class="user-info">
        <text class="user-name">蔗农用户</text>
        <text class="user-id">ID: 888888</text>
      </view>
      <view class="edit-btn">编辑资料</view>
    </view>
    <view class="user-stats">
      <view class="stat-item">
        <text class="stat-value">12</text>
        <text class="stat-label">发布供应</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">8</text>
        <text class="stat-label">采购需求</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">268</text>
        <text class="stat-label">积分</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">5</text>
        <text class="stat-label">优惠券</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-card">
      <view class="menu-item" bindtap="goToOrders">
        <view class="menu-icon order-icon">
          <text>订</text>
        </view>
        <text class="menu-text">我的订单</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToCart">
        <view class="menu-icon cart-icon">
          <text>购</text>
        </view>
        <text class="menu-text">购物车</text>
        <view class="cart-badge">3</view>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToFavorites">
        <view class="menu-icon fav-icon">
          <text>收</text>
        </view>
        <text class="menu-text">我的收藏</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToMessages">
        <view class="menu-icon msg-icon">
          <text>信</text>
        </view>
        <text class="menu-text">消息通知</text>
        <view class="msg-badge">2</view>
        <text class="menu-arrow">→</text>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-item" bindtap="goToSupply">
        <view class="menu-icon supply-icon">
          <text>供</text>
        </view>
        <text class="menu-text">供应管理</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToDemand">
        <view class="menu-icon demand-icon">
          <text>求</text>
        </view>
        <text class="menu-text">需求管理</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToActivities">
        <view class="menu-icon activity-icon">
          <text>活</text>
        </view>
        <text class="menu-text">活动预约</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToCoupons">
        <view class="menu-icon coupon-icon">
          <text>券</text>
        </view>
        <text class="menu-text">优惠券</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-item" bindtap="goToHelp">
        <view class="menu-icon help-icon">
          <text>帮</text>
        </view>
        <text class="menu-text">帮助中心</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToSettings">
        <view class="menu-icon setting-icon">
          <text>设</text>
        </view>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">蔗农帮 v1.0.0</text>
    <text class="footer-copyright">助力乡村振兴 · 践行碳循环经济</text>
  </view>
</view>