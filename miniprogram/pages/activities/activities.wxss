.search-bar {
  display: flex;
  background: white;
  border-radius: 40rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  padding-left: 20rpx;
}

.search-btn {
  background: linear-gradient(135deg, #d4a574 0%, #c49464 100%);
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.activity-banner-swiper {
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.banner {
  position: relative;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 0;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.banner-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.activity-types {
  display: flex;
  justify-content: space-around;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.type-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
}

.all-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.study-icon {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.family-icon {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.farm-icon {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.type-text {
  font-size: 24rpx;
  color: #666;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 200rpx;
}

.activity-card {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.activity-img-wrap {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.activity-img {
  width: 100%;
  height: 280rpx;
  display: block;
}

.activity-scene-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10rpx 0;
  background: rgba(0, 0, 0, 0.5);
  text-align: center;
}

.activity-scene-badge text {
  font-size: 24rpx;
  color: #fff;
}

.activity-info {
  padding: 20rpx;
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.activity-tag {
  background: #e8f5e9;
  color: #4caf50;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.activity-meta {
  display: flex;
  gap: 30rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.meta-icon {
  margin-right: 8rpx;
}

.activity-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.activity-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.highlight-item {
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.activity-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-section {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 26rpx;
  color: #999;
}

.activity-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #e53935;
  margin-left: 8rpx;
}

.price-unit {
  font-size: 24rpx;
  color: #999;
}

.book-btn {
  background: linear-gradient(135deg, #d4a574 0%, #c49464 100%);
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.calendar-section {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.calendar-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.calendar-scroll {
  white-space: nowrap;
}

.calendar-list {
  display: inline-flex;
  gap: 16rpx;
}

.calendar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  min-width: 100rpx;
}

.calendar-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.calendar-week {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.calendar-status {
  margin-top: 8rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.calendar-status.available {
  background: #e8f5e9;
  color: #4caf50;
}

.calendar-status.full {
  background: #ffebee;
  color: #e53935;
}