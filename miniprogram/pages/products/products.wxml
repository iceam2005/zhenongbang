<view class="container">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索环保产品..." />
    <view class="search-btn">搜索</view>
  </view>

  <view class="category-tabs">
    <scroll-view scroll-x class="category-scroll">
      <view class="category-list">
        <view class="category-item {{activeCategory === 'all' ? 'active' : ''}}" bindtap="setCategory" data-category="all">
          全部
        </view>
        <view class="category-item {{activeCategory === 'straw' ? 'active' : ''}}" bindtap="setCategory" data-category="straw">
          可降解吸管
        </view>
        <view class="category-item {{activeCategory === 'box' ? 'active' : ''}}" bindtap="setCategory" data-category="box">
          环保餐盒
        </view>
        <view class="category-item {{activeCategory === 'pot' ? 'active' : ''}}" bindtap="setCategory" data-category="pot">
          农育花盆
        </view>
        <view class="category-item {{activeCategory === 'gift' ? 'active' : ''}}" bindtap="setCategory" data-category="gift">
          文创礼品
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="eco-banner">
    <image class="eco-img" src="{{ecoBannerUrl}}" mode="aspectFill" />
    <view class="eco-overlay">
      <text class="eco-title">碳循环经济</text>
      <text class="eco-desc">每购买一件产品，减少CO₂排放约2.5kg</text>
    </view>
  </view>

  <view class="product-list">
    <view class="product-card" wx:for="{{productList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="product-image-wrapper">
        <image class="product-img" src="{{item.image}}" mode="aspectFill" />
        <view class="product-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
        <view class="product-name-overlay"><text>{{item.name}}</text></view>
      </view>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-desc">{{item.desc}}</text>
        <view class="product-spec">
          <text wx:for="{{item.specs}}" wx:key="index" class="spec-tag">{{item.specs[index]}}</text>
        </view>
        <view class="product-footer">
          <text class="product-price">¥{{item.price}}</text>
          <text class="product-sales">{{item.sales}}已售</text>
        </view>
        <view class="add-cart" catchtap="addToCart" data-id="{{item.id}}">
          <text>+</text>
        </view>
      </view>
    </view>
  </view>

  <view class="cart-bar" wx:if="{{cartCount > 0}}" catchtap="goToCart">
    <view class="cart-icon">
      <text class="cart-num">{{cartCount}}</text>
    </view>
    <text class="cart-total">合计：¥{{cartTotal}}</text>
    <view class="checkout-btn" catchtap="goToCheckout">去结算</view>
  </view>
</view>
