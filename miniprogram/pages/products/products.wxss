.search-bar {
  display: flex;
  background: white;
  border-radius: 40rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  padding-left: 20rpx;
}

.search-btn {
  background: linear-gradient(135deg, #d4a574 0%, #c49464 100%);
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 16rpx 0;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  background: white;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #eee;
}

.category-item.active {
  background: linear-gradient(135deg, #d4a574 0%, #c49464 100%);
  color: white;
  border-color: transparent;
}

.eco-banner {
  position: relative;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.eco-img {
  width: 100%;
  height: 100%;
}

.eco-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
}

.eco-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.eco-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.product-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding-bottom: 150rpx;
}

.product-card {
  width: calc(50% - 10rpx);
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  position: relative;
}

.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.product-img {
  width: 100%;
  height: 100%;
  display: block;
}

.product-name-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10rpx 12rpx;
  background: rgba(0, 0, 0, 0.55);
}

.product-name-overlay text {
  font-size: 24rpx;
  color: #fff;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-icon {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  background: linear-gradient(135deg, #f8f8f8 0%, #f0f0f0 100%);
}

.product-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  z-index: 2;
  background: #e53935;
  color: white;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.product-info {
  padding: 16rpx;
  position: relative;
}

.product-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.product-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-spec {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.spec-tag {
  background: #f5f5f5;
  color: #666;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.product-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #e53935;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
}

.add-cart {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #d4a574 0%, #c49464 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 36rpx;
}

.cart-bar {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: white;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.cart-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.cart-num {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #e53935;
  color: white;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}

.cart-total {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.checkout-btn {
  background: linear-gradient(135deg, #d4a574 0%, #c49464 100%);
  color: white;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}